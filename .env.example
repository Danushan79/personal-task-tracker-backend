# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP server binds to
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/tracker

# Allowed CORS origins: "*", a single origin, or a comma-separated list
CORS_ORIGIN=*

# Logging verbosity: error | warn | info | debug
LOG_LEVEL=debug

# JWT signing secret for short-lived access tokens (min 32 chars)
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# JWT signing secret for long-lived refresh tokens (min 32 chars, must differ from access)
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-of-32-chars

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_TTL=15m

# Refresh token lifetime (e.g. 30d)
JWT_REFRESH_TTL=30d

# bcrypt cost factor for password hashing
BCRYPT_ROUNDS=12

# OpenAI API key — used for both voice transcription (Whisper) and task-draft parsing (GPT)
OPENAI_API_KEY=change-me-to-a-real-openai-api-key

# Whisper transcription model
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Chat model used to turn a transcript into a structured task draft
OPENAI_PARSE_MODEL=gpt-4o-mini
